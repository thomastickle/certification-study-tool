{
  "name": "certification-study-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "test": "npm run build:server && node --import ./tests/svg-loader.ts --test --test-concurrency=2 \"tests/**/*.test.ts\" \"src/web/**/*.test.ts\" && node --test \"build/tests/compiled/**/*.spec.js\"",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "dev": "node --env-file-if-exists=.env scripts/development.ts",
    "start": "node --env-file-if-exists=.env build/src/server/main.js",
    "build": "npm run typecheck && npm run build:server && vite build && node scripts/validate-static-assets.ts",
    "format": "npm run lint -- --fix && prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests scripts/*.ts vite.config.ts eslint.config.mjs --max-warnings 0",
    "check": "npm run format:check && npm run lint && npm test && npm run build",
    "import:curated": "node src/server/importer/curated-batch-cli.ts",
    "database:admin": "node scripts/database-admin.ts",
    "auth:revoke": "node src/server/auth/revoke-sessions.ts",
    "build:server": "node scripts/build-server.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "ajv": "^8.17.1",
    "express": "5.3.0",
    "openid-client": "^6.8.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "^7.3.0"
  }
}
