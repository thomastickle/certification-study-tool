{
  "name": "aws-study-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "node --watch-path=src/server --watch-path=src/shared --watch-path=docs src/server/main.ts",
    "start": "node --env-file-if-exists=.env src/server/main.ts",
    "build": "npm run typecheck && vite build",
    "format": "npm run lint -- --fix && prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src tests vite.config.ts eslint.config.mjs --max-warnings 0",
    "check": "npm run format:check && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.71.2",
    "vite": "^7.3.0"
  }
}
